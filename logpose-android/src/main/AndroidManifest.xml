<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Mock & replay plumbing. Ships ONLY in the real (debug) artifact — the no-op is a plain
      JVM jar with no manifest, so release builds carry none of this.
    -->
    <application>

        <!--
          Zero-config auto-init: this provider starts before Application.onCreate, records the
          host package name, and emits the LogPose `Hello` handshake. No host-app code needed.
          The authority is app-scoped so multiple apps can't collide.
        -->
        <provider
            android:name="io.github.siddharthjaswal.logpose.mock.LogPoseInitProvider"
            android:authorities="${applicationId}.logpose-init"
            android:exported="false"
            android:initOrder="100" />

        <!--
          Reverse channel: the LogPose IDE plugin pushes commands here via
          `adb shell am broadcast` — mock rules (`cmd rules`, the default) and synthetic pushes
          to deliver into the app (`cmd push`). Exported so adb can reach it, but gated on the
          DUMP permission (signature|privileged|development) which the adb shell holds and
          third-party apps cannot obtain.
        -->
        <receiver
            android:name="io.github.siddharthjaswal.logpose.mock.MockCommandReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <!--
          Headless EXPORT channel: an orchestrator dumps the retained capture buffer (when
          LogPoseConfig.exportEnabled) to a file under the app's external-files dir for `adb pull`,
          so CI can assert on the wire without an IDE/MCP session. Same DUMP gate as above.
        -->
        <receiver
            android:name="io.github.siddharthjaswal.logpose.mock.LogPoseExportReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />

    </application>

</manifest>
